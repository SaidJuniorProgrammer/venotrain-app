// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  createdAt DateTime @default(now())
  scores    Score[]
}

model Score {
  id        String   @id @default(uuid())
  level     Int      // Identificador del nivel (1 al 8)
  score     Int      // Puntos de precisión anatómica o bioseguridad
  timeSpent Int      // Tiempo en segundos (para los retos contrarreloj)
  completed Boolean  @default(false)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}